# === Среда выполнения ===
# Для Docker не трогай — переопределяется в docker-compose.yaml
# Для локального запуска на Windows раскомментируй:
# RUNNING_IN_DOCKER=false

# === LLM (llama.cpp) ===
# Windows (раскомментируй для запуска на хосте):
#LLAMA_SERVER_PATH=C:/llama.cpp/llama-server.exe
#LLAMA_MODEL_PATH=C:/llama.cpp/models/Qwen2.5-3B-Instruct-Q6_K.gguf

# Docker/Linux (по умолчанию — не трогай, если запускаешь в контейнере):
# Эти значения переопределяются в docker-compose.yaml, но для надёжности:
LLAMA_SERVER_PATH=/app/llama-bin/llama-server
LLAMA_MODEL_PATH=/app/models/Qwen2.5-3B-Instruct-Q6_K.gguf

# === Настройки LLM ===
LLAMA_PORT=8081
LLAMA_HOST=127.0.0.1
LLAMA_NGL=99
LLAMA_CONTEXT=2048
LLAMA_THREADS=4
LLAMA_FLASH_ATTN=on
LLAMA_CACHE_REUSE=256
LLAMA_NO_MMAP=true

# === Vision модели (SAM3) ===
# Укажи путь к локальным весам SAM3:
SAM3_CHECKPOINT_PATH=C:/models/sam3
VISION_DEVICE=cuda
SAM3_SCORE_THRESHOLD=0.30
SAM3_MAX_BOXES=20
SAM3_MAX_IMAGE_SIZE=1008
SAM3_IMAGE_BATCH_SIZE = 2
# === gRPC сервер ===
GRPC_SERVER_MODULE=app.grps.server
GRPC_PORT=50051
GRPC_HOST=0.0.0.0
GRPC_MAX_WORKERS=4

# === PyTorch оптимизации ===
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
CUDA_VISIBLE_DEVICES=0
USE_TORCH_FP16=true