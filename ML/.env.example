# === Среда выполнения ===
# Для Docker не трогай — переопределяется в docker-compose.yaml
# Для локального запуска на Windows раскомментируй:
# RUNNING_IN_DOCKER=false

# === LLM (llama.cpp + Gemma 4 Vision) ===
# Пути к llama-server и модели здесь не нужны:
# - локально: settings.py автоматически использует C:\llama.cpp\...
# - Docker: пути задаются в docker-compose.yaml через environment:

# === Параметры запуска Gemma (под команду llama-server для Gemma Vision) ===
LLAMA_PORT=8081
LLAMA_HOST=127.0.0.1
LLAMA_NGL=99
LLAMA_CONTEXT=2048
LLAMA_BATCH_SIZE=256
LLAMA_UBATCH_SIZE=256
LLAMA_PARALLEL=1
LLAMA_NO_KV_OFFLOAD=true
LLAMA_FLASH_ATTN=on

# === Фильтрация меток от Gemma ===
GEMMA_MIN_CONFIDENCE=0.6
GEMMA_USE_RELEVANCE_FILTER=true

# === Препроцессинг изображений перед Gemma ===
# GEMMA_MAX_IMAGE_SIZE=2688
# GEMMA_JPEG_QUALITY=95

# === Vision модели (SAM3) ===
SAM3_CHECKPOINT_PATH=C:/models/sam3
VISION_DEVICE=cuda
SAM3_SCORE_THRESHOLD=0.30
SAM3_MAX_BOXES=50
SAM3_MAX_IMAGE_SIZE=1008

# === gRPC сервер ===
GRPC_SERVER_MODULE=app.grps.server
GRPC_PORT=50051
GRPC_HOST=0.0.0.0
GRPC_MAX_WORKERS=4

# === PyTorch оптимизации ===
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
CUDA_VISIBLE_DEVICES=0
USE_TORCH_FP16=true
