# .env.example — скопируй в .env и отредактируй под свою систему

# === Среда выполнения ===
RUNNING_IN_DOCKER=false

# === LLM (llama.cpp) ===
# Пути (раскомментируй нужные для твоей платформы)
# Windows:
#LLAMA_SERVER_PATH=C:\\llama.cpp\\llama-server.exe
#LLAMA_MODEL_PATH=C:\\llama.cpp\\models\\Qwen2.5-3B-Instruct-Q6_K.gguf
# Docker/Linux:
#LLAMA_SERVER_PATH=/host-llama/llama-server
#LLAMA_MODEL_PATH=/host-llama/models/Qwen2.5-3B-Instruct-Q6_K.gguf

LLAMA_PORT=8080
LLAMA_HOST=127.0.0.1
LLAMA_NGL=99
LLAMA_CONTEXT=2048
LLAMA_THREADS=4
LLAMA_FLASH_ATTN=on
LLAMA_CACHE_REUSE=256
LLAMA_NO_MMAP=true

# === Vision модели ===
DINO_MODEL_ID=IDEA-Research/grounding-dino-tiny
SAM_MODEL_ID=facebook/sam-vit-base
VISION_DEVICE=cuda
VISION_MAX_SIDE=640
DINO_BOX_THRESHOLD=0.25
DINO_TEXT_THRESHOLD=0.20
VISION_TORCH_COMPILE=true
VISION_XFORMERS=true
VISION_FLASH_ATTN=true

# === gRPC сервер ===
GRPC_SERVER_MODULE=app.grps.server
GRPC_PORT=50051
GRPC_HOST=0.0.0.0
GRPC_MAX_WORKERS=4

# === PyTorch оптимизации ===
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
CUDA_VISIBLE_DEVICES=0
USE_TORCH_FP16=true