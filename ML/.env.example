# .env.example — скопируй в .env и отредактируй под свою систему

# === Среда выполнения ===
RUNNING_IN_DOCKER=false

# === LLM (llama.cpp + Gemma 4 Vision) ===
# Пути (раскомментируй нужные для твоей платформы)
# Windows:
#LLAMA_SERVER_PATH=C:\\llama.cpp\\llama-server.exe
#LLAMA_MODEL_PATH=C:\\llama.cpp\\models\\google_gemma-4-E4B-it-Q4_K_M.gguf
#LLAMA_MMPROJ_PATH=C:\\llama.cpp\\models\\mmproj-google_gemma-4-E4B-it-f16.gguf
# Docker/Linux:
#LLAMA_SERVER_PATH=/opt/llama.cpp/llama-server
#LLAMA_MODEL_PATH=/opt/llama.cpp/models/google_gemma-4-E4B-it-Q4_K_M.gguf
#LLAMA_MMPROJ_PATH=/opt/llama.cpp/models/mmproj-google_gemma-4-E4B-it-f16.gguf

# Параметры запуска Gemma (под команду llama-server для Gemma Vision)
LLAMA_PORT=8000
LLAMA_HOST=127.0.0.1
LLAMA_NGL=20
LLAMA_CONTEXT=8192
LLAMA_BATCH_SIZE=256
LLAMA_UBATCH_SIZE=256
LLAMA_PARALLEL=1
LLAMA_NO_KV_OFFLOAD=true
LLAMA_FLASH_ATTN=on

# === Фильтрация меток от Gemma ===
GEMMA_MIN_CONFIDENCE=0.6
GEMMA_USE_RELEVANCE_FILTER=true

# === URL для скачивания моделей в Docker (опционально — дефолты в entrypoint.sh) ===
#LLAMA_MODEL_URL=https://huggingface.co/bartowski/google_gemma-4-E4B-it-GGUF/resolve/main/google_gemma-4-E4B-it-Q4_K_M.gguf
#LLAMA_MMPROJ_URL=https://huggingface.co/bartowski/google_gemma-4-E4B-it-GGUF/resolve/main/mmproj-google_gemma-4-E4B-it-f16.gguf

# === SAM3 ===
#SAM3_CHECKPOINT_PATH=C:\\models\\sam3
SAM3_SCORE_THRESHOLD=0.30
SAM3_MAX_BOXES=20
SAM3_MAX_IMAGE_SIZE=672
VISION_DEVICE=cuda

# === gRPC сервер ===
GRPC_SERVER_MODULE=app.grps.server
GRPC_PORT=50051
GRPC_HOST=0.0.0.0
GRPC_MAX_WORKERS=4

# === PyTorch оптимизации ===
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
CUDA_VISIBLE_DEVICES=0
USE_TORCH_FP16=true
